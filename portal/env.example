# OVS Client Portal — copied to portal/.env by `make up` if missing.
# The portal renders an access-problem page until CLIENT_API_KEY is set.

# Issue at: SOC dashboard → Assets → Clients → (client) → Issue portal key
CLIENT_API_KEY=

# Password portal users must enter (recommended even in dev)
PORTAL_PASSWORD=change-me-portal-pass

# Session cookie signing secret (generate: openssl rand -hex 32)
PORTAL_SECRET_KEY=

# Set true when served over HTTPS
PORTAL_COOKIE_SECURE=false

# SOC_API_URL is injected by docker-compose (http://api:8000 on the compose
# network); set it here only for standalone deployments.
