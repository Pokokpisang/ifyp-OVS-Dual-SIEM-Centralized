DATABASE_URL=postgresql://user:password@localhost:5432/siemdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=siemdb

# SIEM agent deployment configuration
SIEM_SERVER_ADDRESS=192.168.88.146

# Port the API listens on
SIEM_API_PORT=8000

# Shadow Mode - set to true to run YAML detection alongside legacy RuleEngine
YAML_DETECTION_SHADOW_MODE=false
YAML_DETECTION_INCLUDE_SUPPRESSED=true
YAML_DETECTION_RETURN_UNMATCHED=false
