DATABASE_URL=postgresql://user:password@localhost:5432/siemdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=siemdb

# SIEM agent deployment configuration
# Set SIEM_SERVER_ADDRESS to your VM's real IP or hostname so remote agents can reach this server.
# If left empty, the system will derive it from the incoming request URL (works for local testing).
# Example: SIEM_SERVER_ADDRESS=http://192.168.100.10
SIEM_SERVER_ADDRESS=192.168.88.146

# Port the API listens on — must match the uvicorn/docker-compose port binding
SIEM_API_PORT=8000
