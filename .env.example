# ============================================================
# .env.example — copy to api/.env and fill in real values.
# Never commit api/.env or any file containing real secrets.
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@db:5432/siemdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=siemdb

# --- OpenSearch / Data Prepper ---
OPENSEARCH_URL=http://opensearch:9200
DATA_PREPPER_URL=http://data-prepper:2021/log/ingest

# --- API server ---
SIEM_API_PORT=8000
SIEM_SERVER_ADDRESS=<your-server-ip>

# --- Detection engine ---
YAML_DETECTION_INCLUDE_SUPPRESSED=true
YAML_DETECTION_RETURN_UNMATCHED=false

# --- Correlation engine ---
ENABLE_CORRELATION_ENGINE=true
CORRELATION_WINDOW_SECONDS=10
CORRELATION_BUFFER_TTL_SECONDS=60
CORRELATION_DEDUP_SECONDS=60

# --- AI Alert Triage (Gemini) ---
# Obtain your key from Google AI Studio.
# Set AI_TRIAGE_ENABLED=true only after adding a valid key.
GEMINI_API_KEY=<replace-with-your-gemini-api-key>
AI_TRIAGE_ENABLED=false

# --- Dashboard Authentication ---
# Generate SECRET_KEY:  openssl rand -hex 32
# Generate HASH:        python -c "import bcrypt,base64; print(base64.b64encode(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt())).decode())"
SESSION_SECRET_KEY=<generate-with-openssl-rand-hex-32>
# RF-5: Set to true (default) to add Secure flag to session cookie.
# Set to false only behind an HTTPS-terminating proxy during development.
SESSION_COOKIE_SECURE=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=<generate-with-bcrypt-see-command-above>

# --- v2.8.0 Security Hardening ---
# ST-041: Session lifetime in seconds (default 8h; was unbounded 14-day cookie)
SESSION_MAX_AGE_SECONDS=28800
# Role for the primary dashboard user (admin or client)
DASHBOARD_ROLE=admin
# Optional second user with reduced access (leave CLIENT_USERNAME blank to disable)
CLIENT_USERNAME=
CLIENT_PASSWORD_HASH=
CLIENT_ROLE=client
# Comma-separated list of additional allowed CORS origins for CSRF checks (empty = same-origin only)
ALLOWED_ORIGINS=
# ST-019: CSRF strictness — set false only in local dev for curl testing
CSRF_STRICT_JSON=true
CSRF_STRICT_FORMS=true
# ST-022: Set true only in local development to expose /docs and /openapi.json
API_DOCS_ENABLED=false

# Notification channels (v2.11.0) — email sender config; webhook channels need none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
