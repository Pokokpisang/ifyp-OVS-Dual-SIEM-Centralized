# ============================================================
# .env.example — copy to api/.env and fill in real values.
# Never commit api/.env or any file containing real secrets.
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@db:5432/siemdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=siemdb

# --- OpenSearch / Data Prepper ---
OPENSEARCH_URL=http://opensearch:9200
DATA_PREPPER_URL=http://data-prepper:2021/log/ingest

# --- API server ---
SIEM_API_PORT=8000
SIEM_SERVER_ADDRESS=<your-server-ip>

# --- Detection engine ---
YAML_DETECTION_INCLUDE_SUPPRESSED=true
YAML_DETECTION_RETURN_UNMATCHED=false

# --- Correlation engine ---
ENABLE_CORRELATION_ENGINE=true
CORRELATION_WINDOW_SECONDS=10
CORRELATION_BUFFER_TTL_SECONDS=60
CORRELATION_DEDUP_SECONDS=60

# --- AI Alert Triage (Gemini) ---
# Obtain your key from Google AI Studio.
# Set AI_TRIAGE_ENABLED=true only after adding a valid key.
GEMINI_API_KEY=<replace-with-your-gemini-api-key>
AI_TRIAGE_ENABLED=false

# --- Dashboard Authentication ---
# Generate SECRET_KEY:  openssl rand -hex 32
# Generate HASH:        python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
SESSION_SECRET_KEY=<generate-with-openssl-rand-hex-32>
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=<generate-with-bcrypt-see-command-above>
